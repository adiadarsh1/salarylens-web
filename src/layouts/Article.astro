---
import Base from './Base.astro';
import ExtensionCta from '../components/ExtensionCta.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { url, canonical } from '../lib/url';
import { articleSchema, breadcrumbSchema } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  path: string;
  heading?: string;
  updated?: string;
  showCta?: boolean;
}
const { title, description, path, heading, updated, showCta = true } = Astro.props;
const canonicalUrl = canonical(Astro.site, import.meta.env.BASE_URL, path);
const schemas = [
  articleSchema(canonicalUrl, heading ?? title, description),
  breadcrumbSchema([
    { name: 'Home', url: canonical(Astro.site, import.meta.env.BASE_URL, '/') },
    { name: heading ?? title, url: canonicalUrl },
  ]),
];
---

<Base title={title} description={description} path={path} jsonLd={schemas}>
  <article class="container-page py-10">
    <nav class="text-xs text-slate-400"><a href={url('/')}>Home</a> / {heading ?? title}</nav>
    <h1 class="mt-2 max-w-3xl text-3xl font-bold sm:text-4xl">{heading ?? title}</h1>
    {updated && <p class="mt-2 text-xs text-slate-400">Updated {updated}</p>}
    <div class="prose-page mt-6">
      <slot />
    </div>
    {showCta && <ExtensionCta />}
    <EmailCapture />
  </article>
</Base>
