---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found" description="The page you're looking for doesn't exist." path="/404/" noindex={true}>
  <section class="container-page py-24 text-center">
    <p class="text-6xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-2xl font-semibold">Page not found</h1>
    <p class="mt-2 text-slate-500">The page you're looking for doesn't exist or has moved.</p>
    <a href={url('/')} class="btn-primary mt-6">Go to the salary calculator</a>
  </section>
</Base>
