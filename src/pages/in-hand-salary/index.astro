---
import Base from '../../layouts/Base.astro';
import ExtensionCta from '../../components/ExtensionCta.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { CTC_VALUES, SITE } from '../../consts';
import { computeInHand } from '../../lib/ctc';
import { formatINR, formatCompactINR } from '../../lib/format';
import { url, canonical } from '../../lib/url';
import { breadcrumbSchema } from '../../lib/schema';

const path = '/in-hand-salary/';
const canonicalUrl = canonical(Astro.site, import.meta.env.BASE_URL, path);
const title = 'In-Hand Salary by CTC (India) — Take-Home for Every LPA';
const description = 'Estimated in-hand salary for common CTCs in India, from 6 LPA to 1 crore. See monthly take-home pay after PF, gratuity and income tax for FY 2025-26.';

const rows = CTC_VALUES.map((ctc) => {
  const b = computeInHand({ ctc, basicPct: 45, variablePct: 10, pfOnActualBasic: true, professionalTaxAnnual: 2_400 });
  return { ctc, lpa: Math.round(ctc / 100000), monthly: b.inHandMonthly, annual: b.inHandAnnual, pct: b.takeHomePct };
});

const schemas = [breadcrumbSchema([
  { name: 'Home', url: canonical(Astro.site, import.meta.env.BASE_URL, '/') },
  { name: 'In-hand by CTC', url: canonicalUrl },
])];
---

<Base title={title} description={description} path={path} jsonLd={schemas}>
  <section class="border-b border-black/5 bg-white">
    <div class="container-page py-10 sm:py-12">
      <h1 class="text-3xl font-bold sm:text-4xl">In-Hand Salary by CTC</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        Estimated monthly take-home for common Indian CTCs ({SITE.fy}, new regime,
        45% basic / 10% variable). Click any row for a full breakdown.
      </p>
    </div>
  </section>

  <section class="container-page py-8">
    <div class="card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-500">
          <tr>
            <th class="px-4 py-3 font-medium">CTC</th>
            <th class="px-4 py-3 font-medium">Monthly in-hand</th>
            <th class="px-4 py-3 font-medium">Annual in-hand</th>
            <th class="px-4 py-3 font-medium">Take-home %</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {rows.map((r) => (
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-3">
                <a href={url(`/in-hand-salary/${r.lpa}-lpa/`)} class="font-medium text-ink hover:text-brand-600">
                  {formatCompactINR(r.ctc)} ({r.lpa} LPA)
                </a>
              </td>
              <td class="px-4 py-3 font-semibold text-brand-700">{formatINR(r.monthly)}</td>
              <td class="px-4 py-3 text-slate-600">{formatINR(r.annual)}</td>
              <td class="px-4 py-3 text-slate-600">{(r.pct * 100).toFixed(1)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <ExtensionCta />
    <EmailCapture />
  </section>
</Base>
