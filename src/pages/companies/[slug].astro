---
import Base from '../../layouts/Base.astro';
import Calculator from '../../components/Calculator.tsx';
import StaticBreakdown from '../../components/StaticBreakdown.astro';
import Faq from '../../components/Faq.astro';
import ExtensionCta from '../../components/ExtensionCta.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { computeInHand, type CtcInput } from '../../lib/ctc';
import { formatINR, formatCompactINR } from '../../lib/format';
import { SITE, COMPANIES, CTC_VALUES, type CompanyPreset } from '../../consts';
import { url, canonical } from '../../lib/url';
import { webAppSchema, faqSchema, breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return COMPANIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: CompanyPreset };
const path = `/companies/${c.slug}/`;
const canonicalUrl = canonical(Astro.site, import.meta.env.BASE_URL, path);

const input: CtcInput = {
  ctc: c.sampleCtc,
  basicPct: c.basicPct,
  variablePct: c.variablePct,
  pfOnActualBasic: c.pfOnActualBasic,
  professionalTaxAnnual: 2_400,
};
const b = computeInHand(input);

const title = `${c.name} In-Hand Salary Calculator (India, FY 2025-26)`;
const description = `Estimate your in-hand salary at ${c.name} in India. For a ${formatCompactINR(c.sampleCtc)} CTC the take-home is about ${formatINR(b.inHandMonthly)}/month. Enter your own offer for an exact breakdown.`;

const faqs = [
  { q: `What is the in-hand salary at ${c.name} for a ${formatCompactINR(c.sampleCtc)} CTC?`, a: `Using ${c.name}'s typical structure (${c.basicPct}% basic, ${c.variablePct}% variable), a ${formatCompactINR(c.sampleCtc)} cash CTC gives about ${formatINR(b.inHandMonthly)}/month in-hand under the new regime for FY 2025-26.` },
  { q: `How is ${c.name}'s salary structured?`, a: `${c.blurb} These are typical, community-observed patterns — your actual offer letter is the source of truth. Use the calculator to enter your exact numbers.` },
  { q: 'Does this include stock / RSUs?', a: 'Cash in-hand excludes stock. If your offer includes RSUs, add the annual vesting value in the calculator\'s advanced options to see total compensation.' },
  { q: 'Are these official numbers?', a: `No. ${c.name} salary structures vary by role, level and location. This tool gives an estimate from a typical split; always rely on your official offer letter.` },
];

const schemas = [
  webAppSchema(canonicalUrl, `${c.name} in-hand salary calculator`, description),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', url: canonical(Astro.site, import.meta.env.BASE_URL, '/') },
    { name: 'By company', url: canonical(Astro.site, import.meta.env.BASE_URL, '/companies/') },
    { name: c.name, url: canonicalUrl },
  ]),
];

const others = COMPANIES.filter((x) => x.slug !== c.slug).slice(0, 8);

// Cross-silo internal links: nearest CTC pages by sample CTC + pillar guides.
const nearLpa = [...CTC_VALUES]
  .sort((a, z) => Math.abs(a - c.sampleCtc) - Math.abs(z - c.sampleCtc))
  .slice(0, 4)
  .map((v) => Math.round(v / 100000));
const relatedLinks = [
  { href: '/new-vs-old-tax-regime/', label: 'New vs Old regime' },
  ...nearLpa.map((n) => ({ href: '/in-hand-salary/' + n + '-lpa/', label: n + ' LPA in-hand' })),
  { href: '/guides/how-in-hand-salary-is-calculated/', label: 'How in-hand is calculated' },
  { href: '/guides/ctc-vs-gross-vs-net/', label: 'CTC vs gross vs net' },
];
---

<Base title={title} description={description} path={path} jsonLd={schemas}>
  <section class="border-b border-black/5 bg-white">
    <div class="container-page py-10 sm:py-12">
      <nav class="text-xs text-slate-400">
        <a href={url('/')}>Home</a> / <a href={url('/companies/')}>By company</a> / {c.name}
      </nav>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{c.name} In-Hand Salary Calculator</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        {c.blurb} For a <strong>{formatCompactINR(c.sampleCtc)}</strong> CTC, the estimated
        take-home is about <strong>{formatINR(b.inHandMonthly)}/month</strong>. Enter your own
        offer below for an exact breakdown.
      </p>
    </div>
  </section>

  <section class="container-page py-8">
    <div class="grid gap-6 lg:grid-cols-2">
      <StaticBreakdown input={input} caption={`Example: ${formatCompactINR(c.sampleCtc)} CTC, ${c.basicPct}% basic, ${c.variablePct}% variable. Typical structure, not official. ${SITE.fy}.`} />
      <div class="prose-page">
        <h2>Estimating your {c.name} take-home</h2>
        <p>
          {c.name} salary offers, like all Indian CTCs, bundle employer PF and gratuity that
          never reach you as cash. On this {formatCompactINR(c.sampleCtc)} example, income tax is
          about {formatINR(b.incomeTaxAnnual)}/year and you build {formatINR(b.totalEpfAnnual)}/year
          in EPF savings.
        </p>
        <p>
          Your real number depends on your level, location and stock component. Put your exact
          CTC into the calculator to see your monthly in-hand.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page">
    <h2 class="mb-4 text-xl font-semibold text-ink">Calculate your exact {c.name} offer</h2>
    <Calculator client:visible initialCtc={c.sampleCtc} initialBasicPct={c.basicPct} initialVariablePct={c.variablePct} initialPfOnActualBasic={c.pfOnActualBasic} />

    <ExtensionCta />

    <div class="mt-10">
      <h2 class="text-xl font-semibold text-ink">Other companies</h2>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
        {others.map((o) => (
          <a href={url(`/companies/${o.slug}/`)} class="card px-4 py-3 text-sm font-medium text-ink hover:ring-brand-200">
            {o.name} →
          </a>
        ))}
      </div>
    </div>

    <RelatedLinks links={relatedLinks} />

    <EmailCapture />
    <Faq items={faqs} />
  </section>
</Base>
