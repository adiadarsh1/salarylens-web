---
import { url } from '../lib/url';

interface Link {
  href: string;
  label: string;
}
interface Props {
  title?: string;
  links: Link[];
}
const { title = 'Related calculators & guides', links } = Astro.props as Props;
---

<nav class="mt-10" aria-label={title}>
  <h2 class="text-xl font-semibold text-ink">{title}</h2>
  <div class="mt-4 flex flex-wrap gap-2">
    {links.map((l) => (
      <a
        href={url(l.href)}
        class="rounded-full border border-black/10 bg-white px-4 py-2 text-sm font-medium text-ink hover:border-brand-300 hover:text-brand-700"
      >
        {l.label}
      </a>
    ))}
  </div>
</nav>
