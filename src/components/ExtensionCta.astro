---
import { SITE } from '../consts';
---

<section class="mt-12 overflow-hidden rounded-2xl bg-ink text-white shadow-card">
  <div class="grid gap-6 p-6 sm:grid-cols-5 sm:items-center sm:p-8">
    <div class="sm:col-span-3">
      <h2 class="text-xl font-semibold text-white">See take-home on every job post — automatically</h2>
      <p class="mt-2 text-sm text-slate-300">
        The free {SITE.name} Chrome extension shows the real in-hand salary right on
        LinkedIn & Naukri listings, so you never have to copy a CTC into a calculator again.
      </p>
    </div>
    <div class="sm:col-span-2 sm:text-right">
      <a href={SITE.extensionUrl} target="_blank" rel="noopener" class="btn-primary bg-brand-500 hover:bg-brand-600">
        Add to Chrome — free
      </a>
    </div>
  </div>
</section>
