---
import { computeInHand, type CtcInput } from '../lib/ctc';
import { formatINR } from '../lib/format';

export interface Props {
  input: CtcInput;
  caption?: string;
}
const { input, caption } = Astro.props;
const b = computeInHand(input);

const rows: Array<[string, string]> = [
  ['Cash CTC (annual)', formatINR(b.ctc)],
  ['Basic salary', formatINR(b.basic)],
  ['Variable / bonus (paid separately)', formatINR(b.variableAnnual)],
  ['Employer PF', `− ${formatINR(b.employerPfAnnual)}`],
  ['Gratuity', `− ${formatINR(b.gratuityAnnual)}`],
  ['Employee PF', `− ${formatINR(b.employeePfAnnual)}`],
  ['Professional tax', `− ${formatINR(b.professionalTaxAnnual)}`],
  ['Income tax (new regime, incl. 4% cess)', `− ${formatINR(b.incomeTaxAnnual)}`],
];
---

<div class="card overflow-hidden">
  <div class="flex flex-wrap items-end justify-between gap-2 bg-brand-600 p-5 text-white">
    <div>
      <p class="text-sm text-brand-50">Estimated monthly in-hand</p>
      <p class="text-3xl font-bold">{formatINR(b.inHandMonthly)}</p>
    </div>
    <div class="text-right">
      <p class="text-sm text-brand-50">Annual in-hand</p>
      <p class="text-xl font-semibold">{formatINR(b.inHandAnnual)}</p>
      <p class="text-xs text-brand-50">{(b.takeHomePct * 100).toFixed(1)}% of cash CTC</p>
    </div>
  </div>
  <table class="w-full text-sm">
    <tbody class="divide-y divide-slate-100">
      {rows.map(([k, v]) => (
        <tr>
          <td class="px-5 py-2.5 text-slate-600">{k}</td>
          <td class="px-5 py-2.5 text-right font-medium text-slate-800">{v}</td>
        </tr>
      ))}
      <tr class="bg-brand-50/60">
        <td class="px-5 py-3 font-semibold text-ink">Annual in-hand (take-home)</td>
        <td class="px-5 py-3 text-right font-bold text-brand-700">{formatINR(b.inHandAnnual)}</td>
      </tr>
    </tbody>
  </table>
  {caption && <p class="border-t border-slate-100 px-5 py-3 text-xs text-slate-400">{caption}</p>}
</div>
