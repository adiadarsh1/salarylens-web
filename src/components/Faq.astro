---
export interface QA {
  q: string;
  a: string;
}
export interface Props {
  items: QA[];
  heading?: string;
}
const { items, heading = 'Frequently asked questions' } = Astro.props;
---

<section class="mt-12">
  <h2 class="text-xl font-semibold text-ink">{heading}</h2>
  <div class="mt-4 divide-y divide-slate-100 rounded-2xl bg-white shadow-card ring-1 ring-black/5">
    {items.map((it) => (
      <details class="group px-5 py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between font-medium text-ink">
          {it.q}
          <span class="text-slate-400 transition group-open:rotate-45">+</span>
        </summary>
        <p class="mt-2 text-sm leading-6 text-slate-600" set:html={it.a} />
      </details>
    ))}
  </div>
</section>
