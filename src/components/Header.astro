---
import { url } from '../lib/url';
import { SITE } from '../consts';

const nav = [
  { label: 'Calculator', href: url('/') },
  { label: 'New vs Old Regime', href: url('/new-vs-old-tax-regime/') },
  { label: 'By Company', href: url('/companies/') },
  { label: 'Guides', href: url('/guides/') },
];
---

<header class="sticky top-0 z-30 border-b border-black/5 bg-white/85 backdrop-blur">
  <div class="container-page flex h-14 items-center justify-between">
    <a href={url('/')} class="flex items-center gap-2 font-semibold text-ink">
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-brand-600 text-white">₹</span>
      <span>{SITE.name}</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-slate-600 md:flex">
      {nav.map((n) => (
        <a href={n.href} class="hover:text-ink">{n.label}</a>
      ))}
    </nav>
    <a href={SITE.extensionUrl} target="_blank" rel="noopener" class="btn-primary !px-3 !py-1.5 text-sm">
      Get the extension
    </a>
  </div>
</header>
