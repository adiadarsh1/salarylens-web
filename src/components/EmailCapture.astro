---
import { SITE } from '../consts';
// MailerLite (or any ESP) form action lives in SITE.newsletterAction.
// When empty, we render a mailto fallback so the CTA is never broken.
const action = SITE.newsletterAction;
const hasEsp = Boolean(action);
---

<section class="mt-8 rounded-2xl border border-brand-100 bg-brand-50 p-6">
  <h2 class="text-lg font-semibold text-ink">Get salary & tax tips for Indian techies</h2>
  <p class="mt-1 text-sm text-slate-600">
    Occasional, no-spam emails on take-home pay, tax-saving and negotiation. Unsubscribe anytime.
  </p>
  {hasEsp ? (
    <form action={action} method="post" target="_blank" class="mt-4 flex flex-col gap-2 sm:flex-row">
      <input
        type="email"
        name="fields[email]"
        required
        placeholder="you@example.com"
        class="w-full rounded-xl border border-slate-200 px-4 py-2.5 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 sm:max-w-xs"
      />
      <button type="submit" class="btn-primary">Subscribe</button>
    </form>
  ) : (
    <a
      href={`mailto:?subject=${encodeURIComponent('Subscribe: SalaryLens tips')}&body=${encodeURIComponent('Add me to the SalaryLens list.')}`}
      class="btn-primary mt-4"
    >
      Notify me
    </a>
  )}
</section>
